<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.humynlabs.gamedata-pipeline</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/adnaan/Documents/hl-gamedata &amp;&amp; PYTHONPATH=. /opt/homebrew/bin/uv run --with numpy --with opencv-python-headless --with rerun-sdk python -m pipeline run</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/adnaan/hl-pipeline/logs/pipeline.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/adnaan/hl-pipeline/logs/pipeline.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
