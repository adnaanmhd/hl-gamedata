[Unit]
Description=HL Phase-1 gaming pipeline run (R8: 30-min tick, queue-drain-then-exit)
Wants=network-online.target
After=network-online.target
# a crash-looping run must not stay silent in journald (review-r1 #31)
OnFailure=hl-pipeline-alert.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__HOME__/hl-gamedata
# 10 workers on e2-standard-32 — permanent since 2026-08-16 (Adnaan;
# supersedes the R22 hold-at-8 and the Q12 16-vCPU shape). Measured:
# 26.3 min/fh at 16vCPU/8w vs ~15 min/fh at 32vCPU/10w. 10 is the
# useful max while V feeds one <=10-session batch (plan §15 two-batch
# feed is the next lever).
Environment=HL_PIPELINE_WORKERS=10
# journald must see run output live, not at exit — python block-buffers
# into the tee pipe otherwise
Environment=PYTHONUNBUFFERED=1
# oneshot default start timeout would kill a multi-hour backlog run
TimeoutStartSec=infinity
# bash for pipefail; tee -> journald AND ~/hl-pipeline/logs/ (plan §7.7).
# uv by absolute path: systemd has no user PATH. The --with trio is
# mandatory (translator/rrd.py imports rerun at module top) and PINNED to
# the versions the suite passed with on this VM 2026-08-15 — an unpinned
# "latest" would silently drift the production runtime on any cache
# refresh (review-r2 #38).
ExecStart=/bin/bash -o pipefail -c 'exec __HOME__/.local/bin/uv run --with numpy==2.4.6 --with opencv-python-headless==5.0.0.93 --with rerun-sdk==0.36.0 python -m pipeline run 2>&1 | tee -a __HOME__/hl-pipeline/logs/pipeline-$(date +%%F).log'
