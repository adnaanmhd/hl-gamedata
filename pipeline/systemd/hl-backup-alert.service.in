[Unit]
Description=Telegram alert when the GCS backup unit fails (review-r2 #49)

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__HOME__/hl-gamedata
ExecStart=__HOME__/.local/bin/uv run python -c "from pipeline import config, telegram; telegram.send_message(config.load(), '⚠️ GCS backup unit FAILED (systemd) — check journalctl -u hl-backup')"
