[Unit]
Description=HL nightly GCS backup — ledger backups, dossiers, reports (R19/§7.7)
Wants=network-online.target
After=network-online.target
# belt for the script's own inline alert — which shares the uv/python
# failure mode it reports (review-r2 #49)
OnFailure=hl-backup-alert.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__HOME__/hl-gamedata
Environment=HL_BACKUP_BUCKET=__BUCKET__
# bounded so a wedged rclone FAILS the unit (firing OnFailure) instead of
# pinning it in 'activating' forever, where every later timer elapse
# no-ops and backups stop silently (review-r4 #33)
TimeoutStartSec=3600
ExecStart=/bin/bash __HOME__/hl-gamedata/pipeline/systemd/hl_backup.sh
