[Unit]
Description=HL nightly GCS backup sync — ledger backups, dossiers, reports (R19/§7.7)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__HOME__/hl-gamedata
Environment=HL_BACKUP_BUCKET=__BUCKET__
TimeoutStartSec=infinity
ExecStart=/bin/bash __HOME__/hl-gamedata/pipeline/systemd/hl_backup.sh
